{
    "name": "Dorkari — দরকারি",
    "short_name": "Dorkari",
    "description": "বাংলাদেশের প্রয়োজনীয় তথ্য এক জায়গায় — হাসপাতাল, ডাক্তার, অ্যাম্বুলেন্স, জরুরি সেবা ও আরও দরকারি তথ্য।",
    "lang": "bn-BD",
    "dir": "ltr",

    "id": "./",
    "start_url": "./",
    "scope": "./",

    "display": "standalone",
